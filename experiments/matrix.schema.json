{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlashFlow concurrency experiment matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases", "comparisons"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    },
    "comparisons": {
      "type": "array",
      "items": { "$ref": "#/$defs/comparison" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "strategy", "vus", "durationSeconds", "initialStock", "skuDistribution", "skuCount", "poolSize", "connectionTimeoutMs", "optimisticMaxRetries", "transactionMaxRetries", "transactionSequence", "admissionMode", "heldResolutionSeconds", "redisImage", "scriptVersion", "generation", "injectedFailure"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "profile": { "enum": ["local", "lab", "messaging-spike", "messaging-live"] },
        "strategy": { "enum": ["CONDITIONAL_ATOMIC", "PESSIMISTIC", "OPTIMISTIC", "UNSAFE_READ_THEN_WRITE"] },
        "vus": { "type": "integer", "minimum": 1 },
        "durationSeconds": { "type": "integer", "minimum": 1 },
        "initialStock": { "type": "integer", "minimum": 0 },
        "skuDistribution": { "enum": ["SINGLE_HOT", "UNIFORM", "ZIPF_HOT"] },
        "skuCount": { "type": "integer", "minimum": 1 },
        "poolSize": { "type": "integer", "minimum": 1 },
        "connectionTimeoutMs": { "type": "integer", "minimum": 1 },
        "optimisticMaxRetries": { "type": "integer", "minimum": 0, "maximum": 20 },
        "transactionMaxRetries": { "type": "integer", "minimum": 0, "maximum": 20 },
        "transactionSequence": { "enum": ["STOCK_FIRST", "CHILD_FIRST_LEGACY"] },
        "admissionMode": { "enum": ["MYSQL_ONLY", "REDIS_LUA"] },
        "heldResolutionSeconds": { "type": "integer", "minimum": 1 },
        "redisImage": { "type": "string", "minLength": 1 },
        "scriptVersion": { "type": "string", "minLength": 1 },
        "generation": { "type": "string", "minLength": 1 },
        "injectedFailure": { "enum": ["NONE", "REDIS_OUTAGE", "AMBIGUOUS_REPLY", "RESTART_STATE_LOSS", "DUPLICATE_LIFECYCLE", "DRIFT_REBUILD"] },
        "messaging": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["brokerImage", "clientVersion", "topology", "acknowledgementMode", "producerRetries", "delayMechanism", "injectedFault"],
          "properties": {
            "brokerImage": { "const": "apache/rocketmq:5.3.4" },
            "clientVersion": { "const": "5.3.4-mqadmin" },
            "topology": { "type": "string", "minLength": 1 },
            "acknowledgementMode": { "type": "string", "minLength": 1 },
            "producerRetries": { "type": "integer", "minimum": 0, "maximum": 3 },
            "delayMechanism": { "type": "string", "minLength": 1 },
            "injectedFault": { "type": "string", "minLength": 1 },
            "live": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["mode", "brokerVersion", "namesrvAddr", "orderTopic", "orderConsumerGroup", "expirationTopic", "expirationConsumerGroup", "deadLetterTopic", "sendTimeoutMs", "maxReconsumeTimes", "delayLevel", "drainSeconds", "injectedFault"],
              "properties": {
                "mode": { "const": "LIVE" },
                "brokerVersion": { "const": "5.3.4" },
                "namesrvAddr": { "type": "string", "minLength": 1 },
                "orderTopic": { "type": "string", "minLength": 1 },
                "orderConsumerGroup": { "type": "string", "minLength": 1 },
                "expirationTopic": { "type": "string", "minLength": 1 },
                "expirationConsumerGroup": { "type": "string", "minLength": 1 },
                "deadLetterTopic": { "type": "string", "minLength": 1 },
                "sendTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 60000 },
                "maxReconsumeTimes": { "type": "integer", "minimum": 0, "maximum": 100 },
                "delayLevel": { "type": "integer", "minimum": 1, "maximum": 18 },
                "drainSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
                "injectedFault": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "factor", "caseIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "factor": { "enum": ["ADMISSION_MODE", "INJECTED_FAILURE", "STRATEGY", "VUS", "POOL_SIZE", "TRANSACTION_RETRY_BUDGET", "TRANSACTION_SEQUENCE", "STOCK_LEVEL", "SKU_CONTENTION_SHAPE"] },
        "caseIds": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
      }
    }
  }
}
