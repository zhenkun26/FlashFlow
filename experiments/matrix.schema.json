{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlashFlow concurrency experiment matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases", "comparisons"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    },
    "comparisons": {
      "type": "array",
      "items": { "$ref": "#/$defs/comparison" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "strategy", "vus", "durationSeconds", "initialStock", "skuDistribution", "skuCount", "poolSize", "connectionTimeoutMs", "optimisticMaxRetries", "transactionMaxRetries", "transactionSequence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "profile": { "enum": ["local", "lab"] },
        "strategy": { "enum": ["CONDITIONAL_ATOMIC", "PESSIMISTIC", "OPTIMISTIC", "UNSAFE_READ_THEN_WRITE"] },
        "vus": { "type": "integer", "minimum": 1 },
        "durationSeconds": { "type": "integer", "minimum": 1 },
        "initialStock": { "type": "integer", "minimum": 0 },
        "skuDistribution": { "enum": ["SINGLE_HOT", "UNIFORM", "ZIPF_HOT"] },
        "skuCount": { "type": "integer", "minimum": 1 },
        "poolSize": { "type": "integer", "minimum": 1 },
        "connectionTimeoutMs": { "type": "integer", "minimum": 1 },
        "optimisticMaxRetries": { "type": "integer", "minimum": 0, "maximum": 20 },
        "transactionMaxRetries": { "type": "integer", "minimum": 0, "maximum": 20 },
        "transactionSequence": { "enum": ["STOCK_FIRST", "CHILD_FIRST_LEGACY"] }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "factor", "caseIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "factor": { "enum": ["STRATEGY", "VUS", "POOL_SIZE", "TRANSACTION_RETRY_BUDGET", "TRANSACTION_SEQUENCE", "STOCK_LEVEL", "SKU_CONTENTION_SHAPE"] },
        "caseIds": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
      }
    }
  }
}
